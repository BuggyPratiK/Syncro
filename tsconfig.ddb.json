{
  // Type-checks the DynamoDB Local suites without running them (they need
  // Docker). `npm run type-check:ddb`; nothing is emitted.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*", "tests/setup.ts", "tests/ddb-local/**/*", "scripts/set-signup-mode.ts"],
  "exclude": ["node_modules", "dist", "infra"]
}
