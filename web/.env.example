# Public build-time values only. Never put secrets, AWS credentials, GitHub
# App keys or Discord webhook URLs here: every VITE_ value ends up in the
# browser bundle.
#
# Copy to .env.local for local development (ignored by git).

# Logto tenant endpoint, e.g. https://<tenant>.logto.app
VITE_LOGTO_ENDPOINT=
# Logto single-page application ID
VITE_LOGTO_APP_ID=
# Logto API resource indicator for the dashboard API
VITE_API_RESOURCE=
# Dashboard API base URL (the local runner listens on http://127.0.0.1:8787)
VITE_API_BASE=http://127.0.0.1:8787

# Development only: run the UI against in-memory fixture data with a fake
# signed-in user. Ignored by production builds.
VITE_FIXTURES=false
