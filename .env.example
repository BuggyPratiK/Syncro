# ============================================================
# Syncro Environment Variables (webhook sender)
# Copy to .env.local for local development.
# NEVER commit real secrets. This file holds NO secret values:
# secrets live in AWS SSM Parameter Store and are referenced by name.
# ============================================================

# --- AWS (AWS_REGION is auto-injected in Lambda; set manually for local dev) ---
AWS_REGION=ap-southeast-2
DYNAMODB_TABLE_NAME=syncro

# --- For local dev with DynamoDB Local (Docker) ---
# DYNAMODB_ENDPOINT=http://localhost:8000

# --- Logging ---
LOG_LEVEL=info

# --- GitHub App ---
GITHUB_APP_ID=123456

# --- Secrets: SSM SecureString parameter NAMES (not values) ---
# Create the parameters once, out of band (standard tier, default aws/ssm key):
#   aws ssm put-parameter --type SecureString --name /syncro/prod/sender/github-app-private-key --value file://key.pem
#   aws ssm put-parameter --type SecureString --name /syncro/prod/sender/github-webhook-secret --value '<secret>'
SSM_PARAM_PREFIX=/syncro/prod
GITHUB_APP_PRIVATE_KEY_PARAM=/syncro/prod/sender/github-app-private-key
GITHUB_WEBHOOK_SECRET_PARAM=/syncro/prod/sender/github-webhook-secret

# Change this value to make running Lambda containers re-read secrets after a rotation.
# SECRETS_EPOCH=2026-01-01.1

# --- Discord ---
# There is no global Discord webhook URL. Each repository sends to the
# destination configured for it; destination URLs are stored in SSM.
