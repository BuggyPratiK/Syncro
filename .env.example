# ============================================================
# Syncro Environment Variables
# Copy to .env.local for local development.
# NEVER commit real secrets.
# ============================================================

# --- AWS (auto-injected in Lambda; set manually for local dev) ---
AWS_REGION=ap-south-1
DYNAMODB_TABLE_NAME=syncro

# --- For local dev with DynamoDB Local (Docker) ---
# DYNAMODB_ENDPOINT=http://localhost:8000

# --- GitHub App ---
GITHUB_APP_ID=123456
# Paste your downloaded .pem private key (or run: npm run setup:secrets)
GITHUB_APP_PRIVATE_KEY="<paste-your-rsa-private-key-here>"
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# --- Discord (MVP) ---
# Create a webhook in your Discord server: Channel Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# --- Default config (can be overridden per-repo in DynamoDB) ---
DEFAULT_WATCHED_BRANCH=main

# --- Telegram (Phase 2 - leave commented until ready) ---
# TELEGRAM_BOT_TOKEN=your-bot-token

# --- Slack (Phase 3 - leave commented until ready) ---
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/<workspace>/<channel>/<token>