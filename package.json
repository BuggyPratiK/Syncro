{
    "name": "syncro",
    "version": "1.0.0",
    "description": "GitHub repository notification bot - AWS Lambda + DynamoDB + Discord",
    "private": true,
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "build:infra": "tsc -p tsconfig.infra.json",
        "build:watch": "tsc -p tsconfig.json --watch",
        "lint": "eslint \"src/**/*.ts\" \"infra/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" \"infra/**/*.ts\" --fix",
        "type-check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.infra.json --noEmit",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "cdk": "cdk",
        "cdk:synth": "cdk synth",
        "cdk:diff": "cdk diff",
        "cdk:deploy": "cdk deploy --require-approval never",
        "cdk:destroy": "cdk destroy",
        "local:start": "sam local start-api --env-vars .env.local.json --port 3000",
        "local:dynamo": "docker run -p 8000:8000 amazon/dynamodb-local",
        "seed": "ts-node scripts/seed-repo.ts",
        "migrate:destinations": "ts-node scripts/migrate-destinations.ts",
        "migrate:destinations:dry-run": "ts-node scripts/migrate-destinations.ts --dry-run",
        "format": "prettier --write \"src/**/*.ts\" \"infra/**/*.ts\"",
        "setup:secrets": "ts-node scripts/setup-aws-secrets.ts"
    },
    "dependencies": {
        "@aws-sdk/client-dynamodb": "^3.682.0",
        "@aws-sdk/lib-dynamodb": "^3.682.0",
        "@octokit/app": "^15.1.0",
        "@octokit/rest": "^21.0.2",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@aws-sdk/client-ssm": "^3.1154.0",
        "@types/aws-lambda": "^8.10.145",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.7.7",
        "@typescript-eslint/eslint-plugin": "^8.10.0",
        "@typescript-eslint/parser": "^8.10.0",
        "aws-cdk": "^2.1146.1",
        "aws-cdk-lib": "^2.164.1",
        "constructs": "^10.4.2",
        "dotenv": "^18.0.8",
        "esbuild": "^0.24.0",
        "eslint": "^9.13.0",
        "jest": "^29.7.0",
        "prettier": "^3.3.3",
        "source-map-support": "^0.5.21",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "typescript": "^5.6.3"
    },
    "allowScripts": {
        "esbuild@0.24.2": true
    }
}
