{
    "name": "syncro",
    "version": "1.0.0",
    "description": "GitHub repository notification bot - AWS Lambda + DynamoDB + Discord",
    "private": true,
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "build:infra": "tsc -p tsconfig.infra.json",
        "build:watch": "tsc -p tsconfig.json --watch",
        "lint": "eslint \"src/**/*.ts\" \"infra/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" \"infra/**/*.ts\" --fix",
        "type-check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.infra.json --noEmit && tsc -p scripts/tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:ddb": "jest --config jest.ddb.config.ts --runInBand",
        "cdk": "cdk",
        "cdk:synth": "cdk synth",
        "cdk:diff": "cdk diff",
        "cdk:deploy": "cdk deploy --require-approval never",
        "cdk:destroy": "cdk destroy",
        "local:dynamo": "docker run --rm -p 8000:8000 amazon/dynamodb-local:3.3.2@sha256:6ada631ec7aa5fc83446855eb17233e3dad184fec47477e8140c6c569cfe0c86",
        "signup:mode": "ts-node scripts/set-signup-mode.ts",
        "dev:dashboard": "ts-node -P scripts/tsconfig.json scripts/dev-dashboard-runner.ts",
        "format": "prettier --write \"src/**/*.ts\" \"infra/**/*.ts\""
    },
    "dependencies": {
        "@aws-sdk/client-dynamodb": "^3.1171.0",
        "@aws-sdk/client-ssm": "3.1171.0",
        "@aws-sdk/lib-dynamodb": "^3.1171.0",
        "@octokit/app": "^15.1.0",
        "@octokit/rest": "^21.0.2",
        "jose": "6.2.17",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/aws-lambda": "^8.10.145",
        "@types/jest": "^29.5.14",
        "@types/node": "^24.19.2",
        "@typescript-eslint/eslint-plugin": "^8.73.0",
        "@typescript-eslint/parser": "^8.73.0",
        "aws-cdk": "^2.1148.1",
        "aws-cdk-lib": "^2.277.0",
        "constructs": "^10.4.2",
        "esbuild": "^0.24.0",
        "eslint": "^9.13.0",
        "jest": "^29.7.0",
        "prettier": "^3.10.1",
        "source-map-support": "^0.5.21",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "~6.0.3"
    },
    "allowScripts": {
        "esbuild@0.24.2": true
    }
}
